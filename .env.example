# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored and must never be committed.

# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers -> copy the SRV URI, then add the DB name.
# Example shape (do not use real credentials here):
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/courier_ops?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign the session JWT (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=

# Optional. Absolute base URL the frontend api-client prefixes onto requests.
# Leave blank to call the same origin (the normal case for local dev).
NEXT_PUBLIC_API_BASE_URL=
